# ------------------------------------------------------------
# Шаблон конфигурации сервиса.
# Скопируйте в .env: cp .env.example .env
# ------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=wallets

# --- URL подключения приложения к БД ---
# Хост "db" — имя сервиса PostgreSQL в docker-compose.
# Должен быть согласован с POSTGRES_* выше.
DATABASE_URL=postgresql+psycopg://user:pass@db/wallets

# --- Логирование ---
LOG_LEVEL=INFO