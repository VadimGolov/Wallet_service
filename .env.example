# ------------------------------------------------------------
# Шаблон конфигурации сервиса.
# Скопируйте в .env: cp .env.example .env
# ------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=wallets
DATABASE_URL=postgresql+psycopg://user:pass@db/wallets

# --- Логирование ---
LOG_LEVEL=INFO