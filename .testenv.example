# ------------------------------------------------------------
# Шаблон конфигурации для тестов.
# Скопируйте в .testenv: cp .testenv.example .testenv
# ------------------------------------------------------------

# --- Тестовая PostgreSQL ---
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_pass
POSTGRES_DB=test_wallets
DATABASE_URL=postgresql+psycopg://test_user:test_pass@db_test/test_wallets

# --- Логирование ---
LOG_LEVEL=DEBUG